# Server-side (BFF → API Gateway). Não commitar secrets.
GATEWAY_URL=https://gateway.example.com
GATEWAY_CLIENT_ID=
GATEWAY_CLIENT_SECRET=
GATEWAY_TARGET_SERVICE=saas-crm

# Client (NEXT_PUBLIC_* entram no bundle no build da imagem)
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_PLATFORM_ADMIN_DOMAINS=cypherops.com.br
# NEXT_PUBLIC_PLATFORM_ADMIN_EMAILS=ops@cypherops.com.br
